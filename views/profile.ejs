<!DOCTYPE html>
<html lang="id">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"><title>Profil — PALL 8BP</title><link rel="stylesheet" href="/style.css">
<link rel="icon" type="image/png" href="/logo.png"></head>
<body class="dashboard-page profile-page">
<div class="pall-dashboard-shell">
  <aside class="pall-sidebar">
    <a class="pall-side-brand" href="/"><img class="brand-logo" src="/logo.png" alt="PALL logo"><span>PALL 8BP<small>PREMIUM CONTROL</small></span></a>
    <div class="pall-side-section">MAIN MENU</div>
    <nav class="pall-side-nav" aria-label="Navigasi utama">
      <a href="/"><span class="pall-nav-icon">▦</span>Dashboard</a>
      <% if (admin.role === 'owner') { %><a href="/admins"><span class="pall-nav-icon">♧</span>Akun Admin</a><% } %>
      <a href="/accounts"><span class="pall-nav-icon">♙</span>Akun User</a>
      <a href="/licenses"><span class="pall-nav-icon">◈</span>Lisensi</a>
      <a href="/devices"><span class="pall-nav-icon">▣</span>Perangkat</a>
      <a href="/audit"><span class="pall-nav-icon">⌁</span>Activity</a>
      <% if (admin.role === 'owner') { %><a href="/settings"><span class="pall-nav-icon">⚙</span>Setelan</a><% } %>
      <a class="is-current" href="/profile"><span class="pall-nav-icon">◎</span>Profil</a>
    </nav>
    <div class="pall-sidebar-bottom"><span class="pall-sidebar-status"><i></i> System Online</span><a href="/logout" class="pall-logout">⇥ &nbsp; Log Out</a></div>
  </aside>
  <div class="pall-dashboard-content">
    <header class="pall-dashboard-header">
      <div><span class="pall-header-kicker">PALL CONTROL CENTER</span><h1>Profil</h1></div>
      <div class="pall-header-tools"><label class="pall-search"><span>⌕</span><input id="pall-dashboard-search" type="search" placeholder="Cari menu atau pengaturan..." aria-label="Cari menu atau pengaturan"></label><a class="pall-profile" href="/profile" title="Buka profil" style="text-decoration:none;color:inherit"><% if (profile.profile_image) { %><img class="pall-avatar" src="<%= profile.profile_image %>" alt="Foto profil" style="object-fit:cover"><% } else { %><span class="pall-avatar"><%= String((profile.display_name || profile.username || 'P').charAt(0)).toUpperCase() %></span><% } %><span><strong><%= profile.display_name || profile.username || 'Administrator' %></strong><small><%= String(profile.role || 'admin').toUpperCase() %></small></span></a></div>
    </header>

<% if (typeof pesan !== 'undefined' && pesan) { %>
  <p class="ok" ><%= pesan %></p>
<% } %>
<% if (typeof error !== 'undefined' && error) { %>
  <p class="err" ><%= error %></p>
<% } %>

<main class="dashboard-main">
  <section class="dashboard-welcome">
    <div class="welcome-copy">
      <span class="eyebrow"><span class="live-dot"></span> ACCOUNT CENTER</span>
      <h2>Profil akun</h2>
      <p>Atur foto, nama tampilan, dan keamanan akun PALL 8BP Anda.</p>
    </div>
    <span class="role-chip welcome-role"><%= String(profile.role || 'admin').toUpperCase() %> ACCOUNT</span>
  </section>

  <div class="profile-grid">
    <section class="panel activity-panel profile-card">
      <div class="activity-heading">
        <div><span class="eyebrow">IDENTITAS</span><h2 style="margin:5px 0 0;">Informasi Profil</h2></div>
      </div>
      <div class="profile-body">
        <div class="profile-identity"><% if (profile.profile_image) { %><img id="profile-preview" class="profile-photo" src="<%= profile.profile_image %>" alt="Foto profil"><% } else { %><div id="profile-fallback" class="profile-photo profile-fallback"><%= String((profile.display_name || profile.username || 'P').charAt(0)).toUpperCase() %></div><img id="profile-preview" class="profile-photo" alt="Pratinjau foto profil" hidden><% } %><div><h3 id="profile-display-preview"><%= profile.display_name || profile.username %></h3><div class="profile-muted">@<%= profile.username %></div><span class="profile-role"><%= String(profile.role || 'admin').toUpperCase() %></span></div></div>
        <form class="profile-form" method="POST" action="/profile/update" id="profile-form">
          <label for="display_name">NAMA TAMPILAN</label>
          <input id="display_name" name="display_name" maxlength="60" value="<%= profile.display_name || '' %>" placeholder="Masukkan nama tampilan">
          <label for="profile-file">FOTO PROFIL</label>
          <input id="profile-file" type="file" accept="image/png,image/jpeg,image/webp">
          <p class="profile-help">Format PNG, JPG, atau WEBP. Foto akan diperkecil otomatis sebelum disimpan.</p>
          <input type="hidden" name="profile_image" id="profile-image-data" value="<%= profile.profile_image || '' %>">
          <div class="profile-actions"><button type="submit">Simpan profil</button></div>
        </form>
        <div class="profile-divider"></div>
        <p class="profile-muted">Username: <strong><%= profile.username %></strong><br>Akun dibuat: <%= profile.created_at ? new Date(profile.created_at).toLocaleDateString('id-ID',{day:'2-digit',month:'long',year:'numeric',timeZone:'Asia/Jakarta'}) : '-' %></p>
      </div>
    </section>

    <section class="panel activity-panel profile-card">
      <div class="activity-heading">
        <div><span class="eyebrow">SECURITY</span><h2 style="margin:5px 0 0;">Keamanan Akun</h2></div>
      </div>
      <div class="profile-body">
        <p class="profile-security-note">Gunakan password unik dan PIN yang tidak mudah ditebak. Jangan bagikan kepada orang lain.</p>
        <form class="profile-form profile-subform" method="POST" action="/security/password" autocomplete="off">
          <h3 class="profile-subhead">Ganti password</h3>
          <label for="old_password">PASSWORD LAMA</label><input id="old_password" name="old_password" type="password" autocomplete="current-password" required>
          <label for="new_password">PASSWORD BARU</label><input id="new_password" name="new_password" type="password" minlength="8" autocomplete="new-password" required>
          <label for="confirm_password">ULANGI PASSWORD BARU</label><input id="confirm_password" name="confirm_password" type="password" minlength="8" autocomplete="new-password" required>
          <div class="profile-actions"><button type="submit">Perbarui password</button></div>
        </form>
        <form class="profile-form profile-subform" method="POST" action="/security/pin" autocomplete="off">
          <h3 class="profile-subhead">Ganti security PIN</h3>
          <label for="old_pin">PIN LAMA</label><input id="old_pin" name="old_pin" type="password" inputmode="numeric" pattern="[0-9]*" maxlength="8" placeholder="PIN lama jika sudah ada">
          <label for="new_pin">PIN BARU (4–8 ANGKA)</label><input id="new_pin" name="new_pin" type="password" inputmode="numeric" pattern="[0-9]{4,8}" minlength="4" maxlength="8" required>
          <div class="profile-actions"><button type="submit">Perbarui PIN</button></div>
        </form>
      </div>
    </section>
  </div>

  <section class="panel activity-panel profile-card profile-history">
    <div class="activity-heading">
      <div><span class="eyebrow">KEAMANAN</span><h2 style="margin:5px 0 0;">Riwayat Login</h2></div>
    </div>
    <% if (typeof loginHistory !== 'undefined' && loginHistory.length) { %>
      <div class="activity-table-wrap">
        <table class="activity-table">
          <thead><tr><th>Status</th><th>Alamat IP</th><th>Waktu (WIB)</th></tr></thead>
          <tbody>
          <% loginHistory.forEach(item => { %>
            <tr>
              <td><span class="<%= item.success ? 'status-active' : 'status-inactive' %>"><%= item.success ? 'BERHASIL' : 'GAGAL' %></span></td>
              <td><%= item.ip || '-' %></td>
              <td><%= new Date(item.created_at).toLocaleString('id-ID', { timeZone: 'Asia/Jakarta' }) %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
      <p class="profile-help" style="padding:0 24px 20px;margin-top:14px;">Percobaan gagal yang tidak Anda kenali bisa berarti ada yang mencoba masuk ke akun ini. Segera ganti password dan PIN.</p>
    <% } else { %>
      <p>Belum ada riwayat login yang tercatat.</p>
    <% } %>
  </section>
</main>
  </div>
</div>

<script>
(function(){
  if (!document.getElementById('pall-video-background')) {
    const video=document.createElement('video'); video.id='pall-video-background'; video.autoplay=true; video.muted=true; video.loop=true; video.playsInline=true; video.setAttribute('aria-hidden','true');
    const source=document.createElement('source'); source.src='/pall-background.mp4'; source.type='video/mp4'; video.appendChild(source);
    const overlay=document.createElement('div'); overlay.id='pall-video-overlay'; overlay.setAttribute('aria-hidden','true');
    document.body.prepend(video); document.body.insertBefore(overlay, video.nextSibling);
    const play=video.play(); if(play && play.catch) play.catch(()=>{});
  }
  // Low-volume background music. Browsers may require the first user interaction before audio can play.
  if (!document.getElementById('pall-backsound')) {
    const audio=document.createElement('audio'); audio.id='pall-backsound'; audio.loop=true; audio.preload='auto'; audio.volume=0.10;
    const audioSource=document.createElement('source'); audioSource.src='/pall-backsound.mp3'; audioSource.type='audio/mpeg'; audio.appendChild(audioSource); document.body.appendChild(audio);
    const startMusic=()=>{ audio.volume=0.10; const p=audio.play(); if(p && p.then) p.then(()=>{document.removeEventListener('pointerdown',startMusic);document.removeEventListener('keydown',startMusic);}).catch(()=>{}); };
    startMusic(); document.addEventListener('pointerdown',startMusic); document.addEventListener('keydown',startMusic);
  }
  if (!document.getElementById('pall-cursor-glow') && window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const cursor=document.createElement('div'); cursor.id='pall-cursor-glow'; cursor.setAttribute('aria-hidden','true'); document.body.appendChild(cursor);
    let raf=0, x=0, y=0; document.addEventListener('mousemove',function(e){x=e.clientX;y=e.clientY;if(!raf)raf=requestAnimationFrame(function(){cursor.style.left=x+'px';cursor.style.top=y+'px';cursor.style.opacity='1';raf=0;});},{passive:true});
    document.addEventListener('mouseleave',()=>cursor.style.opacity='0'); document.addEventListener('mouseenter',()=>cursor.style.opacity='1');
    document.addEventListener('mousedown',()=>cursor.classList.add('is-active')); document.addEventListener('mouseup',()=>cursor.classList.remove('is-active'));
  }
})();
</script>

<script>
(function(){
  if (window.__pallPersistentAudioNav) return;
  window.__pallPersistentAudioNav = true;
  const persistentIds = ['pall-backsound','pall-video-background','pall-video-overlay','pall-cursor-glow'];
  function shouldHandle(a, url) {
    if (!a || !url || url.origin !== location.origin) return false;
    if (a.target && a.target !== '_self') return false;
    if (a.hasAttribute('download')) return false;
    if (url.pathname === '/logout' || url.pathname === '/login' || url.pathname === '/account/password') return false;
    if (url.pathname === location.pathname && url.search === location.search && url.hash) return false;
    return ['http:','https:'].includes(url.protocol);
  }
  async function navigate(url, push=true) {
    document.documentElement.classList.add('pall-page-loading');
    try {
      const response = await fetch(url.href, { credentials:'same-origin', headers:{'X-PALL-NAV':'1'} });
      if (!response.ok || !response.headers.get('content-type')?.includes('text/html')) { location.href=url.href; return; }
      const html = await response.text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const persistent = new Map();
      for (const id of persistentIds) { const node=document.getElementById(id); if(node) persistent.set(id,node); }
      const incoming = Array.from(doc.body.childNodes);
      // PJAX must sync body classes so page-specific styles follow the destination page.
      document.body.className = doc.body.className;
      for (const attr of Array.from(document.body.attributes)) { if (attr.name.startsWith("data-")) document.body.removeAttribute(attr.name); }
      for (const attr of Array.from(doc.body.attributes)) { if (attr.name.startsWith("data-")) document.body.setAttribute(attr.name, attr.value); }
      document.body.replaceChildren();
      for (const node of incoming) {
        if (node.nodeType === Node.ELEMENT_NODE && node.tagName === 'SCRIPT') continue;
        document.body.appendChild(document.importNode(node, true));
      }
      for (const node of persistent.values()) document.body.appendChild(node);
      // Re-run page scripts so page-specific forms and controls keep working.
      for (const oldScript of Array.from(doc.body.querySelectorAll('script'))) {
        const s=document.createElement('script');
        for (const attr of oldScript.attributes) s.setAttribute(attr.name, attr.value);
        s.textContent=oldScript.textContent;
        document.body.appendChild(s);
      }
      document.title = doc.title || 'PALL Panel';
      if (push) history.pushState({pallNav:true}, '', url.href);
      document.documentElement.classList.remove('pall-page-loading');
      window.scrollTo(0,0);
    } catch (e) { document.documentElement.classList.remove('pall-page-loading'); location.href=url.href; }
  }
  document.addEventListener('click', function(e){
    if(e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const a=e.target.closest('a[href]'); if(!a) return;
    let url; try { url=new URL(a.href, location.href); } catch(_){ return; }
    if(!shouldHandle(a,url)) return;
    e.preventDefault(); if(url.href !== location.href) navigate(url,true);
  });
  window.addEventListener('popstate', function(){ navigate(new URL(location.href),false); });
})();
</script>


<script>
(function(){
 const search=document.getElementById('pall-dashboard-search');
 if(!search)return;
 search.addEventListener('input',function(){
   const q=this.value.trim().toLocaleLowerCase('id');
   document.querySelectorAll('.pall-side-nav a').forEach(a=>{a.style.display=!q||a.textContent.toLocaleLowerCase('id').includes(q)?'flex':'none';});
   document.querySelectorAll('.profile-card').forEach(c=>{c.style.display=!q||c.textContent.toLocaleLowerCase('id').includes(q)?'':'none';});
 });
})();
</script>
<script>(function(){var p=location.pathname.replace(/\/$/,'')||'/';document.querySelectorAll('.pall-side-nav a').forEach(function(a){if(a.getAttribute('href')===p)a.classList.add('is-current')});const file=document.getElementById('profile-file'),hidden=document.getElementById('profile-image-data'),preview=document.getElementById('profile-preview'),fallback=document.getElementById('profile-fallback'),form=document.getElementById('profile-form'),name=document.getElementById('display_name'),namePreview=document.getElementById('profile-display-preview');name.addEventListener('input',()=>{namePreview.textContent=name.value.trim()||'<%= profile.username %>'});file.addEventListener('change',function(){const f=this.files&&this.files[0];if(!f)return;if(!/^image\/(png|jpeg|webp)$/.test(f.type)){alert('Pilih file PNG, JPG, atau WEBP.');this.value='';return;}const reader=new FileReader();reader.onload=function(){const img=new Image();img.onload=function(){const c=document.createElement('canvas'),max=400,scale=Math.min(1,max/Math.max(img.width,img.height));c.width=Math.round(img.width*scale);c.height=Math.round(img.height*scale);c.getContext('2d').drawImage(img,0,0,c.width,c.height);const data=c.toDataURL('image/jpeg',.82);hidden.value=data;preview.src=data;preview.hidden=false;if(fallback)fallback.hidden=true;};img.src=reader.result;};reader.readAsDataURL(f);});form.addEventListener('submit',function(e){if(hidden.value.length>1500000){e.preventDefault();alert('Foto terlalu besar. Pilih gambar yang lebih kecil.');}});document.querySelectorAll('input[inputmode="numeric"]').forEach(el=>el.addEventListener('input',function(){this.value=this.value.replace(/\D/g,'').slice(0,8)}));})();</script>
<script src="/pall-enhancements.js" defer></script>
</body>
</html>
